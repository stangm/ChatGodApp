# Written by fetch_voices.py and specific to the locales and flags you chose.
# voices.default.json is the tracked fallback, used when this file is absent.
voices.json

# Your character library: names, art paths and display settings, referencing art
# that only exists on your disk. characters.example.json is the tracked template.
characters.json

# Monthly Azure character count, written by usage.py. Per-machine bookkeeping, and
# regenerable -- deleting it just restarts the count from zero.
usage.json

# YOUR TWITCH TOKEN AND AZURE KEY IN PLAIN TEXT. Never commit this.
# config.example.json is the tracked template.
config.json

# Live slot settings written by slot_state.py -- voice, style, captions, the TTS
# and In-the-show toggles. Per-machine and regenerable: deleting it just puts every
# slot back to its character's defaults.
state.json
